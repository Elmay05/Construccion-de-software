<div class="columns">
  <div class="column">
    <form action="/users/signup" method="POST">
      <!-- Campo oculto para el token CSRF -->
      <input type="gmail" name="_csrf" value="<%= csrfToken %>">
      
      <label for="username" class="label">Correo Electrónico</label>
      <input
        class="input is-primary"
        type="email"
        placeholder="cheewbaca"
        id="username"
        name="username"
        required
      />
      <br><br>

      <label for="password" class="label">Password</label>
      <input
        class="input is-primary"
        type="password"
        id="password"
        name="password"
        required
      />
      <br><br>

      <input type="submit" id="boton_login" class="button is-primary" value="Entrar">
    </form>
  </div>
</div>