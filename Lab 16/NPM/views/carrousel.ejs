<%- include('includes/_header.ejs') %>
<div class="bootstrap-container">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
  <a class="button is-primary" href="/imagenes/agregar">
      Agregar imagen
  </a>
  <% console.log(imagenes); %>
  <div id="carouselExample" class="carousel slide">
      <div class="carousel-inner">
          <% imagenes.forEach((imagen, index) => { %>
          <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
              <img src="/uploads/<%= imagen.imagen %>" class="d-block w-100" alt="Foto de <%= imagen.nombre %>">
          </div>
          <% }); %>
      </div>
      
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</div>
<div class="Bulma-container">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
  <h1 class="title">Lista de Entregas</h1>
 
 <% if(info != '') { %>
     <div class="notification is-info">
         <%= info %>
     </div>
 <% } %>
 
 <br><br>
 <label for="buscar" class="label">Buscar entrega por RFC</label>
<input
    id="buscar-entrega" 
    name="buscar"
    class="input is-info"
    type="text"
    placeholder="AAAA800101"
/>
<br><br>
  <div id="Entregas-container">
    <div class="columns">
      <div class="column is-full">
          <div class="card">
              <div class="card-content">
                  <table class="table is-striped is-fullwidth">
                      <thead>
                          <% if (entregas.length > 0) { %>
                              <tr>
                                  <% Object.keys(entregas[0]).forEach(field => { %>
                                      <th><%= field %></th>
                                  <% }) %>
                              </tr>
                          <% } %>
                      </thead>
                      <tbody>
                          <% entregas.forEach(entrega => { %>
                              <tr>
                                  <% Object.values(entrega).forEach(value => { %>
                                      <td><%= value %></td>
                                  <% }) %>
                              </tr>
                          <% }) %>
                      </tbody>
                  </table>
              </div>
          </div>
      </div>
  </div>
  
  <br><br>

  </div>

 

</div>

<script>
  const btn_buscar = document.getElementById("buscar-entrega");
  //BUSCAR SE USA CON EL ID DEL INPUT
  btn_buscar.onkeyup = () => {
    fetch('/imagenes/buscar/' + btn_buscar.value, {
        method: 'GET',
    }).then((result) => {
      return result.json();
    }).then((data) => {
      //AQUÍ ENTRA EL RESULTADO.JSON EN DATA
      console.log(data)
      let html_container = `
        <div class="columns">
          <div class="column is-full">
            <div class="card">
              <div class="card-content">
                <table class="table is-striped is-fullwidth">
                  <thead>`;

      if (data.entregas.length > 0) {
        html_container += `<tr>`;
        Object.keys(data.entregas[0]).forEach(field => {
          html_container += `<th>${field}</th>`;
        });
        html_container += `</tr></thead><tbody>`;

        data.entregas.forEach(entrega => {
          html_container += `<tr>`;
          Object.values(entrega).forEach(value => {
            html_container += `<td>${value}</td>`;
          });
          html_container += `</tr>`;
        });

        html_container += `</tbody>`;
      } else {
        html_container += `<tr><td colspan="100%">⚠ No se encontraron entregas.</td></tr>`;
      }

      html_container += `
                </table>
              </div>
            </div>
          </div>
        
      `;
      let lista =document.getElementById('Entregas-container');
      lista.innerHTML=html_container;
    }).catch((error) => {
      console.log(error);
    });
  }
</script>




<%- include('includes/_footer.ejs') %>